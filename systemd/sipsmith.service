[Unit]
Description=SIPsmith Lab Services Appliance
Documentation=https://sipsmith.local/docs
After=network.target postgresql.service
Requires=postgresql.service
Wants=sipsmith-agent.service

[Service]
Type=simple
User=sipsmith
Group=sipsmith
WorkingDirectory=/opt/sipsmith/src
ExecStart=/opt/sipsmith/venv/bin/sipsmith
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sipsmith

# §6.1 — ensure uvicorn workers die with the main process on restart so the
# next start does not collide on :8443. KillMode=mixed sends SIGTERM to the main
# unit process and SIGKILL to the rest of the control group after TimeoutStopSec.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=20

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/sipsmith /var/log/sipsmith /run/sipsmith-agent
ProtectHome=yes
RestrictNamespaces=yes
RestrictRealtime=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
