[Unit]
Description=SIPsmith Lab Services Appliance
Documentation=https://sipsmith.local/docs
After=network.target postgresql.service
Requires=postgresql.service
Wants=sipsmith-agent.service

[Service]
Type=simple
User=sipsmith
Group=sipsmith
WorkingDirectory=/opt/sipsmith/src
ExecStart=/opt/sipsmith/venv/bin/sipsmith
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sipsmith

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/sipsmith /var/log/sipsmith /run/sipsmith-agent
ProtectHome=yes
RestrictNamespaces=yes
RestrictRealtime=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
